<?xml version="1.0" encoding="utf-8"?>

<window title="SDL2 GUI Library" width="800" height="600" color-theme-file="ui/dark.colortheme">
  <panel id="Root" orientation="vertical" padding="10" spacing="10" font-size="16">
    <modal id="ModalIdAbout" title="SDL2 GUI Library" width="65%" min-width="380" max-width="500" height="150" border="1">
      <panel orientation="vertical" halign="center" valign="middle" spacing="10">
        <text>A free cross-platform user interface library using SDL2.</text>
        <text>(c) 2021 Adam A. Jammary (Jammary Studio)</text>
      </panel>
    </modal>

    <panel height="35">
      <panel width="50" valign="middle">
        <menu id="Menu" title="Menu">
          <menu-sub id="MenuIdColorTheme" title="Color Theme">
            <menu-item id="MenuIdColorThemeDark"  icon="img/dark-white-512.png"  key="Ctrl+D">Dark</menu-item>
            <menu-item id="MenuIdColorThemeLight" icon="img/light-white-512.png" key="Ctrl+L">Light</menu-item>
          </menu-sub>

          <line />

          <menu-item id="MenuIdAbout" icon="img/info-white-512.png" key="Shift+F1">About</menu-item>
        </menu>
      </panel>

      <panel border-color="#000000" border="1">
        <text-input id="TextInput" placeholder="Text Input" padding="5" background-color="#FFFFFF" text-color="#000000" />
      </panel>

      <panel width="165" halign="right" valign="middle">
        <text font-size="18">SDL2 GUI Library</text>
      </panel>
    </panel>

    <line />

    <panel height="50" spacing="10" font-size="18" halign="center" valign="middle">
      <button
        id="ButtonIdColorThemeDark"
        text="Dark"
        icon="img/dark-512.png"
        width="150"
        background-color="#000000"
        text-color="#FFFFFF"
        border-color="#FFFFFF"
        border="1"
      />

      <toggle id="Toggle" width="50" />

      <button
        id="ButtonIdColorThemeLight"
        text="Light"
        icon="img/light-512.png"
        width="150"
        background-color="#FFFFFF"
        text-color="#000000"
        border-color="#000000"
        border="1"
      />
    </panel>

    <panel orientation="vertical">
      <panel height="30" font-size="18" spacing="10">
        <panel spacing="5">
          <text>Cards:</text>
          <text id="Card" />
        </panel>

        <panel spacing="5">
          <text>List:</text>
          <text id="ListRow" />
        </panel>
      </panel>

      <panel spacing="10">
        <panel id="PanelIdCards" padding="10" border="1">
          <cards id="Cards" card-height="128" card-border="line">
            <card
              title="Card #1 - Risus sed vulputate odio ut"
              description="Nibh tortor id aliquet lectus proin nibh nisl condimentum id.\nVitae semper quis lectus nulla at volutpat diam."
              thumbnail="img/tile-1.jpg"
            />
            <card
              title="Card #2 - Volutpat commodo sed egestas egestas fringilla"
              description="Donec massa sapien faucibus et molestie."
              thumbnail="img/tile-2.jpg"
            />
            <card
              title="Card #3 - Pretium lectus quam id leo in."
              description="Dignissim diam quis enim lobortis scelerisque fermentum.\n\nAliquam faucibus purus in massa tempor nec feugiat."
              thumbnail="img/tile-3.jpg"
            />
            <card
              title="Card #4 - Morbi non arcu risus quis varius"
              description="Dolor sit amet consectetur adipiscing elit duis."
              thumbnail="img/tile-4.jpg"
            />
            <card
              title="Card #5 - Tellus mauris a diam maecenas sed."
              description="Elementum nisi quis eleifend quam adipiscing vitae."
              thumbnail="img/tile-1.jpg"
            />
            <card
              title="Card #6 - A erat nam at lectus urna."
              description="Nam libero justo laoreet sit amet cursus sit amet."
              thumbnail="img/tile-2.jpg"
            />
            <card
              title="Card #7 - Cursus vitae congue mauris rhoncus aenean vel."
              description="Libero enim sed faucibus turpis.\nUllamcorper eget nulla facilisi etiam."
              thumbnail="img/tile-3.jpg"
            />
            <card
              title="Card #8 - Ac auctor augue mauris augue neque."
              description="Euismod lacinia at quis risus."
              thumbnail="img/tile-4.jpg"
            />
          </cards>
        </panel>

        <panel id="PanelIdList" padding="10" border="1">
          <list id="List" sort="ascending">
            <list-item>Lorem ipsum dolor sit amet</list-item>
            <list-item>Consectetur adipiscing elit</list-item>
            <list-item>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua</list-item>
            <list-item>Cursus sit amet dictum sit</list-item>
            <list-item>Turpis in eu mi bibendum neque egestas congue quisque</list-item>
            <list-item>Tellus in hac habitasse platea dictumst</list-item>
            <list-item>Sed elementum tempus egestas sed sed risus pretium quam vulputate</list-item>
            <list-item>Placerat duis ultricies lacus sed turpis tincidunt</list-item>
            <list-item>Amet purus gravida quis blandit turpis cursus in hac habitasse</list-item>
            <list-item>Rutrum tellus pellentesque eu tincidunt tortor aliquam nulla facilisi cras</list-item>
            <list-item>Vulputate ut pharetra sit amet aliquam id diam maecenas ultricies</list-item>
            <list-item>Eu augue ut lectus arcu bibendum at varius vel pharetra</list-item>
          </list>
        </panel>
      </panel>
    </panel>

    <panel orientation="vertical">
      <panel height="30" font-size="18" spacing="10">
        <panel spacing="5">
          <text>Tiles with wrapping:</text>
          <text id="Tile" />
        </panel>

        <panel spacing="5">
          <text>Table with groups:</text>
          <text id="TableWithGroupsRow" />
        </panel>
      </panel>

      <panel spacing="10">
        <panel id="PanelIdTiles" padding="10" border="1">
          <tiles id="Tiles" tile-size="128" spacing="5" font-size="12" text-color="#FFFFFF" text-halign="center" text-valign="bottom" wrap="true">
            <tile image="img/tile-1.jpg" text="Tile #1" />
            <tile image="img/tile-2.jpg" text="Tile #2" />
            <tile image="img/tile-3.jpg" text="Tile #3" />
            <tile image="img/tile-4.jpg" text="Tile #4" />
            <tile image="img/tile-1.jpg" text="Tile #5" />
            <tile image="img/tile-2.jpg" text="Tile #6" />
            <tile image="img/tile-3.jpg" text="Tile #7" />
            <tile image="img/tile-4.jpg" text="Tile #8" />
          </tiles>
        </panel>

        <panel id="PanelIdTableWithGroups" padding="10" border="1">
          <table id="TableWithGroups" show-column-border="true" show-row-border="true" sort="ascending" sort-column="0">
            <table-header>
              <table-column>Dolor</table-column>
              <table-column>Magna</table-column>
            </table-header>

            <table-group group="Vestibulum">
              <table-row>
                <table-column>Risus</table-column>
                <table-column>Sociis natoque penatibus</table-column>
              </table-row>
              <table-row>
                <table-column>Blandit</table-column>
                <table-column>Imperdiet nulla malesuada</table-column>
              </table-row>
            </table-group>

            <table-group group="Quis Hendrerit">
              <table-row>
                <table-column>Congue</table-column>
                <table-column>Sed egestas egestas fringilla phasellus faucibus scelerisque</table-column>
              </table-row>
              <table-row>
                <table-column>Adipiscing</table-column>
                <table-column>Elit pellentesque habitant morbi tristique senectus et</table-column>
              </table-row>
            </table-group>

            <table-row>
              <table-column>Cursus</table-column>
              <table-column>Pellentesque elit eget gravida</table-column>
            </table-row>
            <table-row>
              <table-column>Consequat</table-column>
              <table-column>Ac felis donec et odio pellentesque diam volutpat commodo</table-column>
            </table-row>
          </table>
        </panel>
      </panel>
    </panel>

    <panel height="100" orientation="vertical">
      <panel height="40" valign="middle" spacing="10" font-size="18">
        <text>Slider</text>

        <slider
          id="Slider"
          height="20"
          value="0.5"
          fill-progress="true"
          progress-color="rgb(20, 130, 255)"
          thumb-color="rgb(128, 128, 128)"
          thumb-border-color="#000000"
          thumb-width="20"
          background-color="rgb(192, 192, 192)"
        />

        <panel width="40" halign="right" valign="middle">
          <text id="SliderValue">0.50</text>
        </panel>
      </panel>

      <line />

      <navigation id="Navigation" items-total="10" items-per-navigation="1" height="30" />
    </panel>
  </panel>
</window>
